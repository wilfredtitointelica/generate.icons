<!DOCTYPE html>
<!-- {{ name }}: generated by scripts/build-icons.mjs. Do not edit. -->
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ name }}</title>
  <link rel="stylesheet" href="{{ name }}.css">
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; padding: 24px; font-family: system-ui, sans-serif; color: #1f2933; background: #fff; }
    header { display: flex; flex-wrap: wrap; gap: 12px; align-items: baseline; margin-bottom: 8px; }
    h1 { margin: 0; font-size: 22px; }
    .count { color: #616e7c; font-size: 14px; }
    input { width: 100%; max-width: 360px; padding: 8px 12px; margin: 8px 0 16px; font: inherit; border: 1px solid #cbd2d9; border-radius: 6px; }
    h2 { margin: 24px 0 12px; font-size: 16px; }
    h2 small { color: #616e7c; font-weight: normal; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px; }
    .icon { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 16px 8px 10px; border: 1px solid #e4e7eb; border-radius: 6px; background: #f5f7fa; cursor: pointer; font: inherit; color: inherit; }
    .icon:hover { border-color: #9aa5b1; }
    .icon i { font-size: 32px; }
    .icon code { font-size: 11px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .icon span { font-size: 11px; color: #616e7c; }
    [hidden] { display: none !important; }
  </style>
</head>
<body>
  <header>
    <h1>{{ name }}</h1>
    <span class="count">{{ total }} icons · click an icon to copy its class</span>
  </header>
  <input type="search" placeholder="Search icons" aria-label="Search icons">
{{# each sections }}
  <section data-category>
    <h2>{{ category }} <small>({{ icons.length }})</small></h2>
    <div class="grid">
{{# each icons }}
      <button type="button" class="icon" data-name="{{ name }}" title="{{ name }}">
        <i class="{{ name }}"></i>
        <code>{{ name }}</code>
        <span>U+{{ unicode }} · {{ code }}</span>
      </button>
{{/ each }}
    </div>
  </section>
{{/ each }}
  <script>
    const search = document.querySelector('input');
    search.addEventListener('input', () => {
      const term = search.value.trim().toLowerCase();
      for (const section of document.querySelectorAll('[data-category]')) {
        let visible = 0;
        for (const icon of section.querySelectorAll('.icon')) {
          icon.hidden = !icon.dataset.name.includes(term);
          if (!icon.hidden) visible++;
        }
        section.hidden = visible === 0;
      }
    });
    document.addEventListener('click', (event) => {
      const icon = event.target.closest('.icon');
      if (icon) navigator.clipboard?.writeText(icon.dataset.name);
    });
  </script>
</body>
</html>
