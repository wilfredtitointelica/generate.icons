/* {{ name }}: generated by scripts/build-icons.mjs. Do not edit. */
@font-face {
  font-family: "{{ name }}";
  src: {{{ fontSrc }}};
  font-weight: normal;
  font-style: normal;
  font-display: block;
}

[class^="{{ prefix }}-"]::before,
[class*=" {{ prefix }}-"]::before {
  font-family: "{{ name }}" !important;
  font-style: normal;
  font-weight: normal !important;
  font-variant: normal;
  text-transform: none;
  line-height: 1;
  speak: never;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}
{{# each codepoints }}

.{{ @key }}::before {
  content: "\\{{ codepoint this }}";
}
{{/ each }}
